{
  "id": "pushup",
  "name": "Standard Push-up",
  "description": "Analyzes elbow flexion depth, plank body-line alignment, and signed hip offset through full push-up cadence.",
  "primaryAngleId": "elbow_angle",
  "bottomPhaseId": "bottom",
  "topPhaseId": "plank_up",
  "descendingPhaseId": "descending",
  "ascendingPhaseId": "ascending",
  "reboundAngle": 100,
  "minRomAngle": 145,
  "cyclePhases": ["plank_up", "descending", "bottom", "ascending"],
  "angles": [
    {
      "id": "elbow_angle",
      "name": "Elbow Flexion",
      "description": "Angle formed by shoulder, elbow, and wrist",
      "type": "joint_3pt",
      "leftLandmarks": [11, 13, 15],
      "rightLandmarks": [12, 14, 16],
      "idealRange": [75, 95],
      "unit": "°"
    },
    {
      "id": "signed_hip_deviation",
      "name": "Signed Hip Offset",
      "description": "Perpendicular offset of hip from shoulder-ankle line normalized by torso length (neg: sag, pos: pike)",
      "type": "signed_hip_deviation",
      "leftHipDeviation": [11, 23, 27],
      "rightHipDeviation": [12, 24, 28],
      "idealRange": [-0.08, 0.08],
      "unit": ""
    }
  ],
  "phases": [
    {
      "id": "plank_up",
      "name": "Top (Plank)",
      "color": "#10b981",
      "condition": {
        "angleId": "elbow_angle",
        "operator": ">=",
        "threshold": 155
      }
    },
    {
      "id": "descending",
      "name": "Lowering",
      "color": "#38bdf8",
      "condition": {
        "angleId": "elbow_angle",
        "operator": "<",
        "threshold": 155
      }
    },
    {
      "id": "bottom",
      "name": "Bottom (Chest Down)",
      "color": "#a855f7",
      "condition": {
        "angleId": "elbow_angle",
        "operator": "<=",
        "threshold": 95
      }
    },
    {
      "id": "ascending",
      "name": "Pushing Up",
      "color": "#f59e0b",
      "condition": {
        "angleId": "elbow_angle",
        "operator": ">",
        "threshold": 95
      }
    }
  ],
  "rules": [
    {
      "id": "pushup_depth",
      "name": "Push-up Depth",
      "message": "Lower chest further: elbows should bend to ≤ 95°",
      "severity": "error",
      "triggerPhase": "bottom_requirement",
      "minViolationFrames": 5,
      "condition": {
        "angleId": "elbow_angle",
        "operator": "<=",
        "threshold": 95
      },
      "remedy": "Lower your chest until elbows are at least a 90-degree right angle."
    },
    {
      "id": "hip_sag",
      "name": "Hip Sagging",
      "message": "Hips sagging below line: tighten glutes & abs",
      "severity": "error",
      "triggerPhase": "all",
      "minViolationFrames": 5,
      "condition": {
        "angleId": "signed_hip_deviation",
        "operator": "<",
        "threshold": -0.10
      },
      "remedy": "Squeeze core, glutes, and thighs to bring your pelvis back up into line."
    },
    {
      "id": "hip_pike",
      "name": "Hips Piked High",
      "message": "Hips raised too high: level spine with shoulders",
      "severity": "warning",
      "triggerPhase": "all",
      "minViolationFrames": 5,
      "condition": {
        "angleId": "signed_hip_deviation",
        "operator": ">",
        "threshold": 0.12
      },
      "remedy": "Bring your pelvis down into a straight horizontal plank aligned with your feet and shoulders."
    }
  ]
}
